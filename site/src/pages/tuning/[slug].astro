---
import Base from "../../layouts/Base.astro";
import Blocks from "../../components/Blocks.astro";
import { TOOLS } from "../../data/tools";
import { faqJsonLd } from "../../lib/blocks";
import { href, absolute } from "../../lib/site";

export function getStaticPaths() {
  return TOOLS.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const path = `/tuning/${tool.slug}`;

const rows: [string, string, string][] = [
  [
    "<code>stall</code>",
    tool.caps.stall ?? "30m (built-in)",
    "hang backstop — no output <em>and</em> no CPU/IO activity for this long",
  ],
  [
    "<code>max-time</code>",
    tool.caps.neverMaxTime ? "<strong>never set one</strong>" : (tool.caps.maxTime ?? "—"),
    "wall-clock budget — the only cap that bounds a run that is working but will never finish",
  ],
  ["<code>max-mem</code>", tool.caps.maxMem ?? "unset — opt in only if it has hurt you", "RSS ceiling across the process tree"],
  ["<code>max-parallel</code>", tool.caps.maxParallel !== undefined ? String(tool.caps.maxParallel) : "2 (built-in)", "slots per name-and-directory bucket"],
];

const jsonLd = [
  {
    "@type": "TechArticle",
    headline: tool.title,
    description: tool.description,
    url: absolute(path),
    about: { "@type": "SoftwareApplication", name: tool.name },
    isPartOf: { "@type": "WebPage", "@id": absolute("/tuning") },
  },
  faqJsonLd(tool.faqs),
];

const related = TOOLS.filter((t) => t.slug !== tool.slug && t.category === tool.category);
---
<Base
  title={tool.title}
  description={tool.description}
  path={path}
  crumbs={[{ label: "Tuning", path: "/tuning" }, { label: tool.name, path }]}
  jsonLd={jsonLd}
>
  <style>
    .meta { font-family: var(--mono); font-size: 0.82rem; color: var(--fg-dim); margin-top: -0.5rem; }
    .faq h3 { margin-bottom: 0.25rem; }
    .faq p { margin-top: 0.25rem; color: var(--fg-dim); }
    .more { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; list-style: none; }
    .more a {
      display: inline-block;
      border: 1px solid var(--border);
      background: var(--bg-alt);
      border-radius: 999px;
      padding: 0.3rem 0.8rem;
      font-size: 0.85rem;
      text-decoration: none;
    }
    figcaption { font-family: var(--mono); font-size: 0.8rem; color: var(--fg-dim); margin-bottom: 0.4rem; }
    .sources { font-size: 0.88rem; color: var(--fg-dim); }
  </style>

  <h1>Tuning tman for {tool.name}</h1>
  <p class="meta">{tool.ecosystem}</p>
  <p>{tool.tagline}</p>

  <h2 id="recommended-caps">Recommended starting caps</h2>
  <table>
    <thead><tr><th>cap</th><th>start at</th><th>what it answers</th></tr></thead>
    <tbody>
      {rows.map(([cap, value, meaning]) => (
        <tr><td set:html={cap} /><td set:html={value} /><td set:html={meaning} /></tr>
      ))}
    </tbody>
  </table>
  <blockquote>
    <p>
      These are <strong>starting points derived from how {tool.name} behaves</strong>, not
      measurements of your machine. Every one of them should be replaced by a number you took from
      your own runs — the last section on this page is how.
    </p>
  </blockquote>

  <figure>
    <figcaption>.tman.kdl</figcaption>
    <pre><code class="language-kdl">{tool.kdl}</code></pre>
  </figure>

  <Blocks blocks={tool.blocks} />

  <h2 id="faq">Frequently asked</h2>
  <div class="faq">
    {tool.faqs.map((f) => (
      <>
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </>
    ))}
  </div>

  {related.length > 0 && (
    <>
      <h2 id="related">Related tools</h2>
      <ul class="more">
        {related.map((t) => <li><a href={href(`/tuning/${t.slug}`)}>{t.name}</a></li>)}
      </ul>
    </>
  )}

  <h2 id="sources">Sources</h2>
  <ul class="sources">
    {tool.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
  </ul>
</Base>
