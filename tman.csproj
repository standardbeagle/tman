<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>tman</AssemblyName>
    <RootNamespace>Tman</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Tman.Tests" />
  </ItemGroup>

  <!--
    This project is the application and contains no tests, so a test run aimed at it can only be a
    mistake — and an unguarded one is the worst kind, because `dotnet test` in this directory
    resolves this file, restores, runs nothing, and exits 0. Answer with the command that does run
    the suite.

    VSTest is the target `dotnet test` invokes and the only one that does, so `dotnet build`,
    `dotnet run`, `dotnet publish`, and building this project as a reference of Tman.Tests all stay
    untouched. Covered by Tman.Tests.RootDotnetTestGuardTests, both the refusal and that boundary.
  -->
  <Target Name="RefuseTestRunsAgainstTheApplicationProject" BeforeTargets="VSTest">
    <Error Code="TMAN0001"
           Text="tman.csproj is the application project and contains no tests, so this run would have exited 0 having run nothing. Run the suite with:  sh -c &quot;exec ./test&quot;  (equivalently: dotnet test tests/Tman.Tests/Tman.Tests.csproj)" />
  </Target>

</Project>
