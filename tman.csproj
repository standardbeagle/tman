<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>tman</AssemblyName>
    <RootNamespace>Tman</RootNamespace>
    <Version>0.7.9</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Tman.Tests" />
  </ItemGroup>

  <!--
    native/tman_sigint.c counts SIGINTs in signal context (see Interrupt.cs for why that cannot be
    managed code). A run under the JIT — `dotnet build`, `dotnet run`, the test suite's apphost —
    loads it as a shared library beside the assembly; the NativeAOT publish links its object
    statically, so the published binary stays one file. Windows has no SIGINT and builds neither.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TmanSigintSource>$(MSBuildThisFileDirectory)native/tman_sigint.c</TmanSigintSource>
    <TmanSigintLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libtman_sigint.dylib</TmanSigintLibName>
    <TmanSigintLibName Condition="'$(TmanSigintLibName)' == ''">libtman_sigint.so</TmanSigintLibName>
    <!-- a macOS publish names its architecture; clang otherwise builds the host's -->
    <TmanSigintArch Condition="'$(RuntimeIdentifier)' == 'osx-x64'">-arch x86_64</TmanSigintArch>
    <TmanSigintArch Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">-arch arm64</TmanSigintArch>
  </PropertyGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <None Include="$(IntermediateOutputPath)$(TmanSigintLibName)" Link="$(TmanSigintLibName)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
    <NativeLibrary Include="$(IntermediateOutputPath)tman_sigint.o" />
    <DirectPInvoke Include="tman_sigint" />
  </ItemGroup>

  <Target Name="CompileTmanSigint" BeforeTargets="CoreCompile" Condition="'$(OS)' != 'Windows_NT'"
          Inputs="$(TmanSigintSource)"
          Outputs="$(IntermediateOutputPath)$(TmanSigintLibName);$(IntermediateOutputPath)tman_sigint.o">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="cc -std=c11 -O2 -fPIC -Wall -Werror $(TmanSigintArch) -shared -o &quot;$(IntermediateOutputPath)$(TmanSigintLibName)&quot; &quot;$(TmanSigintSource)&quot;" />
    <Exec Command="cc -std=c11 -O2 -fPIC -Wall -Werror $(TmanSigintArch) -c -o &quot;$(IntermediateOutputPath)tman_sigint.o&quot; &quot;$(TmanSigintSource)&quot;" />
  </Target>

  <!--
    This project is the application and contains no tests, so a test run aimed at it can only be a
    mistake — and an unguarded one is the worst kind, because `dotnet test` in this directory
    resolves this file, restores, runs nothing, and exits 0. Answer with the command that does run
    the suite.

    VSTest is the target `dotnet test` invokes and the only one that does, so `dotnet build`,
    `dotnet run`, `dotnet publish`, and building this project as a reference of Tman.Tests all stay
    untouched. Covered by Tman.Tests.RootDotnetTestGuardTests, both the refusal and that boundary.
  -->
  <Target Name="RefuseTestRunsAgainstTheApplicationProject" BeforeTargets="VSTest">
    <Error Code="TMAN0001"
           Text="tman.csproj is the application project and contains no tests, so this run would have exited 0 having run nothing. Run the suite with:  sh -c &quot;exec ./test&quot;  (equivalently: dotnet test tests/Tman.Tests/Tman.Tests.csproj)" />
  </Target>

</Project>
